# Copy to .env for local development. Never commit .env.

# Local Postgres from docker-compose.yml
DATABASE_URL="postgresql://hockey:hockey@localhost:5434/hockey_iq"

# At least 32 random characters. Generate with: openssl rand -base64 32
SESSION_PASSWORD=""

# Optional: Sentry error monitoring (leave empty to disable)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Log level for pino: trace | debug | info | warn | error
LOG_LEVEL="info"
